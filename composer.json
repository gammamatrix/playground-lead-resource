{
    "name": "gammamatrix/playground-lead-resource",
    "description": "Playground: Provides an API and a Blade UI for interacting with Playground Lead, a Playground Campaign and Lead Sales Management tool for Laravel applications.",
    "keywords": [
        "gammamatrix",
        "laravel",
        "lead",
        "campaign",
        "opportunity",
        "opportunities",
        "sales",
        "playground",
        "playground-blade"
    ],
    "homepage": "https://github.com/gammamatrix/playground-lead-resource",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Postlethwaite",
            "email": "jeremy.postlethwaite@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "gammamatrix/playground": "*",
        "gammamatrix/playground-auth": "*",
        "gammamatrix/playground-http": "*",
        "gammamatrix/playground-lead": "*",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "gammamatrix/playground-test": "*",
        "gammamatrix/playground-login-blade": "*",
        "gammamatrix/playground-site-blade": "*",
        "illuminate/testing": "^13.0",
        "tomasvotruba/bladestan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Playground\\Lead\\Resource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Feature\\Playground\\Lead\\Resource\\": "tests/Feature/",
            "Tests\\Unit\\Playground\\Lead\\Resource\\": "tests/Unit/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "gammamatrix/*": "source",
            "*": "dist"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "75.x-dev"
        },
        "laravel": {
            "providers": [
                "Playground\\Lead\\Resource\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --verbose --debug --level max",
        "cloc": "cloc --exclude-dir=node_modules,output,vendor .",
        "format": "vendor/bin/pint",
        "format-blade": "npx prettier --write \"resources/views/**/*.blade.php\"",
        "test": "vendor/bin/testbench package:test",
        "test-dev": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit-dev.xml"
        ],
        "test-parallel": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/paratest -c phpunit-dev.xml"
        ]
    }
}
